# Template for `.env`. Copy to `.env` and fill in. `.env` is gitignored.
# `bin/run` sources this before each command.
#
# The SAME repo runs in two places — your laptop (orchestration / analysis)
# and the ephemeral TPU VM (compute) — each with its own `.env`. Keys tagged
# [VM] matter on the TPU, [local] on your laptop, untagged on both.
# `gcp/bootstrap.sh` writes a VM-appropriate `.env` at provision time.

# --- Identity ---
CRSID=zw499

# --- TPU (course-managed project — COMPUTE ONLY, no durable storage here) ---
PROJECT_ID=dis-2026-tpu-${CRSID}
ZONE=us-east5-b
ACCELERATOR_TYPE=v6e-1
RUNTIME_VERSION=v2-alpha-tpuv6e
TPU_NAME=dis-2026-${CRSID}-tpu
QR_NAME=dis-2026-${CRSID}-qr          # queued-resource name (best-practice provisioning)
TPU_SPOT=1                            # 1 = Spot (cheap, preemptible); 0 = on-demand

# --- Durable storage (YOUR project + billing; survives TPU deletion) ---
GCS_PROJECT=myloop-2026
GCS_BUCKET=dis-2026-zw499-tpu-store   # leave EMPTY to use local-pull mode (no bucket)
# Cross-project auth for the TPU -> bucket. Pick ONE (see gcp/setup_storage.sh):
#   keyless : grant the dis default compute SA objectAdmin on the bucket (no secret on the VM)
#   key     : point this at an SA key file copied to the VM
# GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/sa-key.json   # [VM]

# --- Code sync to the VM ---
GIT_REMOTE=                           # e.g. git@github.com:wdk0082/<repo>.git (SSH for private repos)
GIT_REF=main
# GIT_DEPLOY_KEY=gcp/keys/deploy_key  # read-only deploy key (private repo); scp'd to the VM by bootstrap.sh

# --- Device ---
DEVICE=                               # [VM] tpu  |  [local] cpu or blank (auto)

# --- On-VM ephemeral scratch (caches + staging; LOST on TPU delete) --- [VM]
SCRATCH=$HOME/scratch
HF_HOME=${SCRATCH}/hf
WANDB_DIR=${SCRATCH}/wandb
UV_CACHE_DIR=${SCRATCH}/uv-cache
ARTIFACT_DIR=${SCRATCH}/artifacts     # local staging; launch.sh syncs -> GCS

# --- Durable output locations (GCS) ---
CKPT_DIR=gs://${GCS_BUCKET}/checkpoints     # checkpoints write straight to GCS
GCS_ARTIFACTS=gs://${GCS_BUCKET}/artifacts  # synced artifacts land here

# --- Local pull destination --- [local]
LOCAL_ARTIFACTS=./artifacts

# --- Secrets / W&B ---
# HF_TOKEN=
# WANDB_API_KEY=
# WANDB_PROJECT=
