# Template for `.env`. Copy to `.env` and fill in. `.env` is gitignored.
# `bin/run` sources this before each command.
#
# If the repo runs on more than one machine (laptop for orchestration /
# analysis, a remote box for heavy compute), each machine keeps its own
# `.env` derived from this file — `DEVICE` and the paths below are the
# usual differences.

# --- Device ---
DEVICE=                               # cuda | mps | cpu | blank = auto-detect

# --- Durable output locations (gitignored; local by default) ---
ARTIFACT_DIR=./artifacts              # per-experiment artifacts: $ARTIFACT_DIR/exp_NNN/
CKPT_DIR=./checkpoints                # checkpoints: $CKPT_DIR/exp_NNN/

# --- Caches (optional; point heavy caches at a scratch disk) ---
# SCRATCH=$HOME/scratch
# HF_HOME=${SCRATCH}/hf
# WANDB_DIR=${SCRATCH}/wandb
# UV_CACHE_DIR=${SCRATCH}/uv-cache

# --- Secrets / W&B ---
# HF_TOKEN=
# WANDB_API_KEY=
# WANDB_PROJECT=
